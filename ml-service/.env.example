# ScamSense ML service configuration.
#
# ML_SERVICE_SECRET must be byte-identical to the value in backend/.env — it is
# the shared key Laravel uses to HMAC-sign each request body and this service
# uses to verify it. Requests that are unsigned, wrongly signed, or older than
# 60 seconds are rejected (AGENTS.md §3).
ML_SERVICE_SECRET=

# Bind address. Keep this on loopback: the service is internal-only and must
# never be reachable from the internet (AGENTS.md §2, rule 1).
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5001
