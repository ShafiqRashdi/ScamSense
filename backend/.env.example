APP_NAME=ScamSense
# PRODUCTION: set APP_ENV=production and APP_DEBUG=false.
# Leaving APP_DEBUG=true in production shows stack traces containing file
# paths, configuration and query fragments to anyone who triggers an error.
# On a platform, set these as environment variables rather than copying a file.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The public UI is bilingual (AGENTS.md O2). Indicator codes returned by the ML
# service are mapped to prose through lang/en and lang/ms, never sent as prose.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────────
# MySQL 8. Create the schema before migrating:  CREATE DATABASE scamsense;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scamsense
# PRODUCTION: never root. Create a user scoped to this schema only —
#   CREATE USER 'scamsense_app'@'%' IDENTIFIED BY '<strong-password>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON scamsense.* TO 'scamsense_app'@'%';
# See docs/deployment.md. A root credential turns any injection into full
# server compromise, including every other schema on the instance.
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: SESSION_SECURE_COOKIE=true. Over plain HTTP the session cookie
# is sent in the clear; the deployment enforces HTTPS, so this must be true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@scamsense.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── ML service (internal hop) ──────────────────────────────────────────────
# The Flask service is NEVER exposed to the internet (AGENTS.md §2, rule 1).
# Bind it to localhost or a private network; all public traffic enters through
# Laravel. ML_SERVICE_SECRET is the shared key Laravel uses to HMAC-sign each
# request body and Flask uses to verify it, rejecting anything older than 60s.
# Generate one with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ML_SERVICE_URL=http://127.0.0.1:5001
ML_SERVICE_SECRET=

# ── Threat intelligence ────────────────────────────────────────────────────
# Both are optional: if a key is absent or the provider is unreachable, the
# verdict degrades to a partial result rather than failing (AGENTS.md §2 rule 4).
# ScamSense never fetches a submitted URL itself — reputation lookups only.
# VirusTotal's free tier allows 4 requests/minute, hence the 24h cache.
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=

# ── Administrator account (AdminUserSeeder) ────────────────────────────────
# Leave ADMIN_PASSWORD empty and the seeder generates a random one, printing it
# to the console exactly once. Never commit a real password here.
ADMIN_NAME="ScamSense Administrator"
ADMIN_EMAIL=admin@scamsense.local
ADMIN_PASSWORD=

# ── Data retention (PDPA 2010) ─────────────────────────────────────────────
# Submissions older than this are deleted by the scheduled scamsense:purge
# command. Keep this in step with the privacy notice on the form.
RETENTION_SUBMISSION_DAYS=90

VITE_APP_NAME="${APP_NAME}"
