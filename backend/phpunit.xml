<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run against MySQL, not in-memory SQLite.

            SQLite is faster, but it does not share MySQL's behaviour where this
            schema depends on it: index length limits under utf8mb4, JSON column
            semantics, and ENUM handling. Running the suite on a different engine
            from the application hides exactly the bugs that would surface in a
            live demo. The test database is separate from the development one and
            is truncated by RefreshDatabase on every run.

            Create it once with:
              CREATE DATABASE scamsense_test
                CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="scamsense_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            No real threat-intel calls from tests, ever. Without these the suite
            read the real keys from .env, and every test that faked only the ML
            service sent its URL to VirusTotal and Safe Browsing for real.
            RefreshDatabase empties the 24-hour cache each time, so nothing was
            ever reused. It exhausted the 500-a-day VirusTotal quota on
            2026-09-29, and the deployed site shares that key. A test that needs
            a provider sets the key with config() and fakes the HTTP call.
            force="true" so a key set in the OS environment cannot leak through.
        -->
        <env name="VIRUSTOTAL_KEY" value="" force="true"/>
        <env name="GOOGLE_SAFE_BROWSING_KEY" value="" force="true"/>
    </php>
</phpunit>
